    {
      "parameters": {
        "jsCode": "// Datos\nconst registros = $input.all().map(i => i.json);\n\nif (registros.length === 0) {\n  return [{ json: { error: 'No existen registros para este id_evaluacion' }}];\n}\n\n// Limpieza: excluir incompletos\nconst completos = registros.filter(r => r.respuesta_usuario && r.respuesta_correcta);\nconst incompletos = registros.length - completos.length;\n\n// Distribución y conteo\nconst total = completos.length;\nlet correctas = 0;\nconst fallosPorPregunta = {};\n\nfor (const r of completos) {\n  const esCorrecta = r.respuesta_usuario === r.respuesta_correcta;\n  if (esCorrecta) correctas++;\n  else {\n    const p = r.pregunta;\n    if (!fallosPorPregunta[p]) fallosPorPregunta[p] = 0;\n    fallosPorPregunta[p]++;\n  }\n}\n\n// Métricas\nconst promedioAcierto = Number(((correctas / total) * 100).toFixed(2));\nconst preguntasOrdenadas = Object.entries(fallosPorPregunta)\n  .sort((a, b) => b[1] - a[1])\n  .map(([pregunta, fallos]) => ({ pregunta, fallos }));\n\nreturn [{\n  json: {\n    total_respuestas_analizadas: total,\n    respuestas_incompletas: incompletos,\n    promedio_acierto: promedioAcierto,\n    preguntas_mas_falladas: preguntasOrdenadas.slice(0, 5),\n    distribucion_fallos: preguntasOrdenadas\n  }\n}];"
      },
