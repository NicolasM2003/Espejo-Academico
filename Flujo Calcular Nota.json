      "retryOnFail": false,
      "notesInFlow": false,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const desglose = $input.all().map(item => item.json);\n\nconst porCorreo = {};\n\nfor (const fila of desglose) {\n  const correo = fila.correo;\n  if (!porCorreo[correo]) {\n    porCorreo[correo] = {\n      correo,\n      total_preguntas: 0,\n      respuestas_correctas: 0,\n    };\n  }\n\n  porCorreo[correo].total_preguntas += 1;\n  if (fila.estado === \"Correcta\") {\n    porCorreo[correo].respuestas_correctas += 1;\n  }\n}\n\nconst salida = [];\n\nfor (const correo in porCorreo) {\n  const data = porCorreo[correo];\n  const porcentaje =\n    data.total_preguntas > 0\n      ? (data.respuestas_correctas / data.total_preguntas) * 100\n      : 0;\n\n  // Ajusta la regla de notas como quieras:\n  let nota_final = 1;\n  if (porcentaje >= 60) nota_final = 7;\n  else if (porcentaje >= 40) nota_final = 4;\n\n  salida.push({\n    json: {\n      correo: data.correo,\n      total_preguntas: data.total_preguntas,\n      respuesta_correctas: data.respuestas_correctas,\n      porcentaje_aciertos: `${porcentaje.toFixed(2)}%`,\n      nota_final,\n    },\n  });\n}\n\nreturn salida;\n\n"
      },
