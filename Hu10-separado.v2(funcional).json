    {
      "parameters": {
        "jsCode": "// 1. Obtenemos todos los items (respuestas Y resumen)\nconst allItems = $input.all();\n\n// 2. Extraemos el item de resumen (el último de la lista)\nconst resumenItem = allItems.pop(); \nconst resumen = resumenItem.json;\n\n// 3. El resto de los items son las respuestas\nconst allAnswers = allItems.map(i => i.json);\n\n// --- 4. NUEVO: Calcular estadísticas ---\n// (Leemos los datos que vienen de la hoja \"Resumen_Preguntas\")\nconst total = parseInt(resumen.total_preguntas) || allAnswers.length;\nconst correctas = parseInt(resumen.respuestas_correctas) || 0;\nconst incorrectas = total - correctas;\nconst porcentaje = total > 0 ? ((correctas / total) * 100).toFixed(0) : 0;\n\n// --- 5. Construir el cuerpo del Email ---\nlet body = `Hola ${resumen.correo},<br><br>`;\nbody += `Hemos revisado tu evaluación. Aquí está tu resumen:<br><br>`;\n\n// --- NUEVO: Bloque de estadísticas ---\nbody += `<div style=\"background-color: #f4f4f4; border: 1px solid #ddd; padding: 15px; border-radius: 5px; margin-bottom: 20px; font-size: 1.1em;\">`;\nbody += `<strong>Nota Final: ${resumen.nota_final}</strong><br><br>`;\nbody += `<strong>Porcentaje de Acierto:</strong> ${porcentaje}%<br>`;\nbody += `<strong>Total de Preguntas:</strong> ${total}<br>`;\nbody += `<strong>Respuestas Correctas:</strong> ${correctas}<br>`;\nbody += `<strong>Respuestas Incorrectas:</strong> ${incorrectas}<br>`;\nbody += `</div>`;\n\nbody += `Este es el detalle de tus respuestas:<br><br>`;\n\n// --- 6. Recorrer TODAS las respuestas (sin cambios) ---\nfor (const item of allAnswers) {\n  body += `<div style=\"border: 1px solid #ddd; padding: 10px; margin-bottom: 15px; border-radius: 5px; background-color: #f9f9f9;\">`;\n  body += `<h3>Pregunta: ${item.pregunta}</h3>`;\n  body += `<p><strong>Tu respuesta:</strong> ${item.respuesta_usuario}</p>`;\n  body += `<p><strong>Respuesta correcta:</strong> ${item.respuesta_correcta}</p>`;\n  \n  if (item.explicacion) {\n    body += `<hr style=\"border: 0; border-top: 1px solid #eee;\">`;\n    body += `<p><strong>Explicación:</strong><br>${item.explicacion}</p>`;\n  }\n  \n  body += `</div>`;\n}\n\nbody += `<br>¡Sigue estudiando!`;\n\n// --- 7. Devolver el objeto para el email (sin cambios) ---\nreturn [{\n  json: {\n    emailTo: resumen.correo,\n    emailSubject: `Feedback de tu evaluación (Nota: ${resumen.nota_final})`,\n    emailBody: body\n  }\n}];"
      },
