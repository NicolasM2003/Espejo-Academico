        "jsCode": "// Obtenemos los datos del nodo anterior\nconst items = $input.all();\n\n// Recorremos los items (usualmente es solo 1)\nfor (const item of items) {\n  // Obtenemos el texto Base64 del PDF\n  const base64String = item.json.response;\n\n  // Creamos la estructura binaria que n8n necesita para los archivos\n  item.binary = {\n    data: {\n      data: base64String,\n      mimeType: 'application/pdf',\n      fileName: 'Feedback_Evaluacion.pdf' // Puedes cambiar el nombre aquí si quieres\n    }\n  };\n}\n\nreturn items;"
