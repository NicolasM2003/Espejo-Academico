      "parameters": {
        "jsCode": "// 1. Obtenemos todos los datos\nlet items = $input.all();\n\n// --- FILTRO ANTI-DUPLICADOS ---\nconst preguntasVistas = new Set();\nitems = items.filter(item => {\n  const pregunta = item.json.pregunta;\n  if (preguntasVistas.has(pregunta)) {\n    return false;\n  }\n  preguntasVistas.add(pregunta);\n  return true;\n});\n\n// 2. Datos del resumen\nconst resumen = items[0] ? items[0].json : {};\n\n// 3. Cálculos\nconst total = items.length; \nconst correctas = items.filter(item => item.json.respuesta_usuario === item.json.respuesta_correcta).length;\nconst porcentaje = total > 0 ? ((correctas / total) * 100).toFixed(0) : 0;\n\n// 4. Construcción del PDF\nlet htmlPdf = `\n<html>\n<head>\n<style>\n  body { font-family: Helvetica, Arial, sans-serif; padding: 40px; font-size: 12px; color: #333; }\n  h1 { font-size: 18px; margin-bottom: 10px; }\n  h2 { font-size: 14px; margin-top: 20px; margin-bottom: 10px; border-bottom: 2px solid #eee; padding-bottom: 5px; }\n  .header-info { margin-bottom: 20px; }\n  .stats-box { border: 1px solid #ccc; padding: 15px; background: #f9f9f9; margin-bottom: 30px; border-radius: 4px; }\n  .pregunta-container { margin-bottom: 20px; page-break-inside: avoid; }\n  .pregunta-titulo { font-weight: bold; display: block; margin-bottom: 5px; font-size: 13px; }\n  .respuesta-usuario { margin-bottom: 5px; }\n  \n  /* Estilos para Feedback */\n  .status-correcta { color: #28a745; font-weight: bold; margin-top: 5px; }\n  .status-incorrecta { color: #d9534f; font-weight: bold; margin-top: 5px; }\n  \n  .explicacion-box { \n      background-color: #fff3cd; \n      padding: 10px; \n      margin-top: 8px; \n      border-left: 4px solid #f0ad4e; \n      font-style: italic; \n      font-size: 11px;\n  }\n</style>\n</head>\n<body>\n\n  <h1>Reporte de Evaluación</h1>\n  <div class=\"header-info\">\n    <strong>Estudiante:</strong> ${resumen.correo || 'Estudiante'}\n  </div>\n  \n  <div class=\"stats-box\">\n    <h3>Resumen de Resultados</h3>\n    <p><strong>Nota Final:</strong> ${resumen.nota_final || '-'}</p>\n    <p><strong>Acierto:</strong> ${porcentaje}% (${correctas}/${total})</p>\n  </div>\n\n  <h2>Detalle de respuestas:</h2>\n`;\n\nfor (const item of items) {\n  const data = item.json;\n  const esCorrecta = data.respuesta_usuario === data.respuesta_correcta;\n  \n  htmlPdf += `<div class=\"pregunta-container\">`;\n  htmlPdf += `<span class=\"pregunta-titulo\">${data.pregunta}</span>`;\n  htmlPdf += `<div class=\"respuesta-usuario\">Tu respuesta: ${data.respuesta_usuario}</div>`;\n  \n  // Lógica de visualización SIEMPRE visible\n  if (esCorrecta) {\n      htmlPdf += `<div class=\"status-correcta\">¡Correcto!</div>`;\n  } else {\n      htmlPdf += `<div class=\"status-incorrecta\">Correcta: ${data.respuesta_correcta}</div>`;\n  }\n\n  // Mostrar explicación SIEMPRE (si existe en los datos)\n  if (data.explicacion) {\n      htmlPdf += `<div class=\"explicacion-box\"><strong>Explicación:</strong> ${data.explicacion}</div>`;\n  }\n\n  htmlPdf += `</div><hr style=\"border:0; border-top:1px solid #eee;\">`;\n}\n\nhtmlPdf += `</body></html>`;\n\n// 5. Retorno\nreturn [{\n  json: {\n    emailTo: resumen.correo,\n    emailSubject: `Resultados Evaluación: ${resumen.nota_final || 'N/A'}`,\n    emailBody: `Adjunto encontrarás tu reporte de evaluación. Nota: ${resumen.nota_final}`,\n    pdfHtml: htmlPdf,\n    pdfFileName: `Feedback_${resumen.id_evaluacion || 'Evaluacion'}.pdf` \n  }\n}];"
      },
