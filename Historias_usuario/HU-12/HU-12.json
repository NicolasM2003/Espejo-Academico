    {
      "parameters": {
        "jsCode": "// Entrada: 1 item desde el Webhook\nconst root = items[0].json;\n\n// Si viene anidado en body (Webhook), lo tomamos de ahí\nconst entrada = root.body || root;\n\nconst id_evaluacion  = entrada.id_evaluacion;\nconst id_intento     = entrada.id_intento;\nconst email          = entrada.email;\nconst nombreCompleto = entrada.nombre_completo;\nconst respuestas     = entrada.respuestas || {};\n\n// Campos que NO queremos tratar como preguntas\nconst camposIgnorar = new Set([\n  'Nombre Completo',\n  'Marca temporal',\n  'Dirección de correo electrónico',\n  'Puntuación',\n]);\n\nconst salida = [];\n\n// Recorremos todas las claves del objeto \"respuestas\"\nfor (const tituloPregunta of Object.keys(respuestas)) {\n  if (camposIgnorar.has(tituloPregunta)) continue;\n\n  // Cada entrada es un array, nos quedamos con la primera respuesta\n  const respuestaArray = respuestas[tituloPregunta] || [];\n  const respuestaUsuario = respuestaArray.length > 0\n    ? String(respuestaArray[0]).trim()\n    : '';\n\n  salida.push({\n    json: {\n      id_evaluacion,\n      id_intento,\n      correo: email,\n      nombre_completo: nombreCompleto,\n      pregunta: tituloPregunta,\n      respuesta_usuario: respuestaUsuario,\n    },\n  });\n}\n\nreturn salida;\n"
      },
