    {
      "parameters": {
        "jsCode": "// Entrada: salida del nodo de comparación\nconst respuestas = $input.all().map(i => i.json);\n\n// Agrupar por usuario/correo\nconst usuarios = {};\n\n// Recorrer todas las respuestas\nfor (const r of respuestas) {\n  const correo = r.correo;\n\n  if (!usuarios[correo]) {\n    usuarios[correo] = {\n      correo: correo,\n      total_preguntas: 0,\n      respuestas_correctas: 0,\n      desglose: []\n    };\n  }\n\n  // Contar totales\n  usuarios[correo].total_preguntas += 1;\n  if (r.estado === \"✅ Correcta\") {\n    usuarios[correo].respuestas_correctas += 1;\n  }\n\n  // Agregar al desglose\n  usuarios[correo].desglose.push({\n    pregunta: r.pregunta,\n    respuesta_usuario: r.respuesta_usuario,\n    respuesta_correcta: r.respuesta_correcta,\n    estado: r.estado,\n    explicacion: r.explicacion,\n    fuente: r.fuente\n  });\n}\n\n// Calcular porcentaje y nota final para cada usuario\nfor (const correo in usuarios) {\n  const u = usuarios[correo];\n  const porcentaje = (u.respuestas_correctas / u.total_preguntas) * 100;\n  u.porcentaje_aciertos = porcentaje.toFixed(2) + \"%\";\n  u.nota_final = (1 + (porcentaje / 100) * 6).toFixed(2); // Escala 1–7\n}\n\n// Salida como array\nreturn Object.values(usuarios).map(u => ({ json: u }));\n"
      },
