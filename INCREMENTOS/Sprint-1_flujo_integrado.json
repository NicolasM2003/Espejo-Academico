    {
      "parameters": {
        "jsCode": "// Obtenemos todos los datos del Typeform\nconst data = $json;\n\n// Extraemos el email (ajusta el nombre exacto del campo si es distinto)\nconst email = data.Email || data.email || null;\n\n// Creamos un arreglo con las preguntas (las claves que comienzan con \"¿\")\nconst result = Object.keys(data)\n  .filter(k => k.startsWith(\"¿\")) // solo las preguntas del formulario\n  .map(pregunta => ({\n    email,                // agregamos el email a cada resultado\n    pregunta,             // la pregunta\n    respuesta: data[pregunta] // la respuesta correspondiente\n  }));\n\n// Devolvemos cada par pregunta/respuesta como un item separado\nreturn result.map(item => ({ json: item }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        -96
      ],
      "id": "51a7e533-aeba-44a3-bff9-24f312cf0bc8",
      "name": "Separador de respuesta"
    },
    {
      "parameters": {
        "jsCode": "// Función para normalizar texto (quita tildes, mayúsculas y espacios extras)\nfunction normalizar(texto) {\n  return texto\n    ?.toString()\n    .normalize(\"NFD\") // separa acentos\n    .replace(/[\\u0300-\\u036f]/g, \"\") // elimina acentos\n    .replace(/['‘’\"“”]/g, \"\") // elimina comillas\n    .replace(/\\s+/g, \" \") // espacios múltiples -> uno\n    .trim()\n    .toLowerCase();\n}\n\n// Entradas\nconst respuestasUsuario = $items(\"Respuestas\").map(i => i.json);\nconst bancoPreguntas = $items(\"Banco preguntas\").map(i => i.json);\n\nconst resultados = [];\nlet totalCorrectas = 0; // Contador de respuestas correctas\nconst preguntasRespondidas = new Set(); // Para evitar duplicados\n\nfor (const resp of respuestasUsuario) {\n  const preguntaUsuario = normalizar(resp.pregunta);\n\n  // Si ya procesamos esta pregunta, saltamos al siguiente ciclo\n  if (preguntasRespondidas.has(preguntaUsuario)) {\n    continue; \n  }\n\n  // Marcamos esta pregunta como procesada\n  preguntasRespondidas.add(preguntaUsuario);\n\n  // Buscar coincidencia flexible\n  const banco = bancoPreguntas.find(\n    b => normalizar(b.Pregunta).includes(preguntaUsuario) || preguntaUsuario.includes(normalizar(b.Pregunta))\n  );\n\n  // Determinar respuesta correcta\n  let respuestaCorrecta = null;\n  if (banco) {\n    const letra = banco.Respuesta_Correcta?.trim().toUpperCase();\n    switch (letra) {\n      case \"A\": respuestaCorrecta = banco.Alt_A; break;\n      case \"B\": respuestaCorrecta = banco.Alt_B; break;\n      case \"C\": respuestaCorrecta = banco.Alt_C; break;\n      case \"D\": respuestaCorrecta = banco.Alt_D; break;\n    }\n  }\n\n  // Comparar respuestas (también normalizadas)\n  const correcta =\n    respuestaCorrecta &&\n    normalizar(respuestaCorrecta) === normalizar(resp.respuesta);\n\n  // Sumar 1 al puntaje si la respuesta es correcta\n  if (correcta) {\n    totalCorrectas++;\n  }\n\n  resultados.push({\n    row_number: resp.row_number,\n    correo: resp.Correo,\n    pregunta: resp.pregunta,\n    respuesta_usuario: resp.respuesta,\n    respuesta_correcta: respuestaCorrecta || \"No encontrada\",\n    estado: correcta ? \"✅ Correcta\" : \"❌ Incorrecta\",\n    explicacion: banco?.Explicacion || \"\",\n   \n  });\n}\n\n\nreturn resultados.map(r => ({ json: r }));\n"
      },
