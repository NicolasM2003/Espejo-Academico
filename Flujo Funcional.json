    {
      "parameters": {
        "jsCode": "const respuestas = $input.all().map(item => item.json);\nconst banco = $items('Banco preguntas').map(item => item.json);\n\n// Índice de preguntas del banco\nconst indexBanco = new Map();\nfor (const q of banco) {\n  const key = String(q.pregunta || \"\").trim();\n  indexBanco.set(key, q);\n}\n\nconst salida = [];\n\nfor (const r of respuestas) {\n  const correo = r.correo;\n\n  // 👇 SI NO HAY CORREO, LO SALTAMOS (son filas basura / banco / cabecera)\n  if (!correo) {\n    continue;\n  }\n\n  const pregunta = String(r.pregunta || \"\").trim();\n\n  // Usa respuesta_usuario si existe, si no, usa respuesta\n  const respuestaUsuario = String(\n    r.respuesta_usuario ?? r.respuesta ?? \"\"\n  ).trim();\n\n  const registroBanco = indexBanco.get(pregunta);\n\n  let respuestaCorrectaTexto = \"No encontrada\";\n  let estado = \"Incorrecta\";\n  let explicacion = \"\";\n\n  if (registroBanco) {\n    const letra = String(registroBanco.respuesta_correcta || \"\")\n      .trim()\n      .toUpperCase();\n    const campo = \"alt_\" + letra;\n\n    const valorAlt = registroBanco[campo];\n    const valorAltStr =\n      valorAlt === undefined || valorAlt === null ? \"\" : String(valorAlt);\n\n    respuestaCorrectaTexto = valorAltStr.trim() || \"No encontrada\";\n\n    explicacion = registroBanco.explicacion\n      ? String(registroBanco.explicacion)\n      : \"\";\n\n    if (\n      respuestaUsuario !== \"\" &&\n      respuestaCorrectaTexto !== \"No encontrada\" &&\n      respuestaUsuario === respuestaCorrectaTexto\n    ) {\n      estado = \"Correcta\";\n    }\n  }\n\n  salida.push({\n    json: {\n      correo,\n      pregunta,\n      respuesta_usuario: respuestaUsuario,\n      respuesta_correcta: respuestaCorrectaTexto,\n      estado,\n      explicacion,\n    },\n  });\n}\n\nreturn salida;\n"
      },
      "type": "n8n-nodes-base.code",
