    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\n// Claves estáticas EXACTAS según llegan desde Google Forms / Sheets\nconst staticKeys = [\n    \"Marca temporal\",\n    \"Dirección de correo electrónico\",\n    \"Nombre completo\",      // por si viene así\n    \"Nombre Completo\"       // ESTA es la clave que te está faltando\n];\n\nfor (const item of items) {\n    const data = item.json;\n\n    // Detectar correctamente el nombre y correo\n    const nombreCompleto = data[\"Nombre Completo\"] || data[\"Nombre completo\"] || \"\";\n    const correo = data[\"Dirección de correo electrónico\"] || \"\";\n\n    for (const key in data) {\n        if (!staticKeys.includes(key)) {\n            // Valor de la respuesta\n            const respuesta = data[key] || \"\";\n\n            output.push({\n                json: {\n                    nombreCompleto,\n                    correo,\n                    pregunta: key,\n                    respuesta\n                }\n            });\n        }\n    }\n}\n\nreturn output;"
      },
