    {
      "parameters": {
        "jsCode": "const entrada = $input.item.json;\n\nconst email = (entrada.email || '').trim().toLowerCase();\nconst token = (entrada.token || '').trim();\n\nconst registros = $items('Leer_Autorizados').map(i => i.json);\n\nlet autorizado = false;\nlet motivo = \"\";\nlet estudiante = null;\n\nfor (const row of registros) {\n  const rowEmail = String(row.email || '').trim().toLowerCase();\n  const rowToken = String(row.token || '').trim();\n  const activo = String(row.activo || '').trim().toLowerCase() === 'si';\n\n  if (!activo) continue;\n\n  if (email === rowEmail || token === rowToken) {\n    autorizado = true;\n    estudiante = row;\n    break;\n  }\n}\n\nif (!autorizado) motivo = 'Credenciales inválidas';\n\nreturn [{\n  json: {\n    autorizado,\n    motivo,\n    estudiante,\n    ...entrada\n  }\n}];"
      },
