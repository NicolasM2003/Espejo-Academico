    {
      "parameters": {
        "jsCode": "// Obtenemos los datos del estudiante desde el primer nodo (el Trigger)\nconst student = $items('Google Sheets Trigger')[0].json;\n\n// Obtenemos la lista de respuestas incorrectas (lo que entró a este nodo)\nconst incorrectas = $input.all().map(i => i.json);\n\n// Obtenemos los datos de la hoja Resumen_Preguntas para la nota\nconst resumen = $items('Google Sheets Trigger')[0].json;\n\n// --- 1. Construir el cuerpo del Email ---\nlet body = `Hola ${resumen.correo},<br><br>`;\nbody += `Hemos revisado tu evaluación. Tu nota final es: **${resumen.nota_final}**.<br><br>`;\nbody += `Aquí tienes el detalle de tus respuestas incorrectas para que puedas repasar:<br><br>`;\n\n// --- 2. Crear una sección por cada respuesta incorrecta ---\nfor (const item of incorrectas) {\n  // Usamos los datos de las columnas del \"Desgloce_preguntas.csv\"\n  body += `<div style=\"border: 1px solid #ddd; padding: 10px; margin-bottom: 15px; border-radius: 5px; background-color: #f9f9f9;\">`;\n  body += `<h3>Pregunta: ${item.pregunta}</h3>`;\n  body += `<p><strong>Tu respuesta:</strong> ${item.respuesta_usuario}</p>`;\n  body += `<p><strong>Respuesta correcta:</strong> ${item.respuesta_correcta}</p>`;\n  \n  // Añadimos la explicación\n  body += `<hr style=\"border: 0; border-top: 1px solid #eee;\">`;\n  body += `<p><strong>Explicación:</strong><br>${item.explicacion}</p>`;\n  body += `</div>`;\n}\n\nbody += `<br>¡Sigue estudiando!`;\n\n// --- 3. Devolver un solo objeto con toda la información para el email ---\nreturn [{\n  json: {\n    emailTo: resumen.correo,\n    emailSubject: `Feedback de tu evaluación (Nota: ${resumen.nota_final})`,\n    emailBody: body\n  }\n}];"
      },
